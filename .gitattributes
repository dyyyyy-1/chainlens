# 统一换行符：仓库内一律 LF，避免 Windows 上反复出现
# "LF will be replaced by CRLF" 警告，也避免 shell 脚本被 CRLF 破坏。
* text=auto eol=lf

*.go     text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf

# 二进制文件不做换行转换。
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
