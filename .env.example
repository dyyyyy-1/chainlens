DATABASE_URL=postgres://chainlens:chainlens_dev@localhost:5432/chainlens?sslmode=disable
RPC_HTTP_URL=https://ethereum-rpc.publicnode.com
ETHERSCAN_API_KEY=
CHAIN_ID=1
TARGET_CONTRACT=
START_BLOCK=0
CONFIRMATIONS=12
BATCH_BLOCK_RANGE=2000
# 单次批量请求容纳的块头数。publicnode 允许 100；drpc 免费档只允许 3。
# 换端点补历史时必须与 BATCH_BLOCK_RANGE 一起调整，否则块头阶段会被拒。
RPC_HEADER_BATCH=100
LOG_LEVEL=info

# 查询服务（cmd/api）的监听地址，缺省 :8080。
# 索引器不读这一项。
HTTP_ADDR=:8080
