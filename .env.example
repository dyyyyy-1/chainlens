DATABASE_URL=postgres://chainlens:chainlens_dev@localhost:5432/chainlens?sslmode=disable

# 索引器必填。查询服务（cmd/api）用它与 CHAIN_ID 启用链上余额，
# 两者缺一即自动关闭该能力（响应里 onchain.enabled=false），不影响其他接口。
RPC_HTTP_URL=https://ethereum-rpc.publicnode.com
# Etherscan V2 API key，仅 cmd/verify -source etherscan 使用。
# 免费档：3 次/秒、10 万次/天、单次响应最多 1000 条记录（超出会静默截断，对拍工具会主动报错）。
ETHERSCAN_API_KEY=
CHAIN_ID=1
# 索引目标。TARGET_CONTRACTS 优先（逗号分隔）；只配一个合约时用 TARGET_CONTRACT 即可。
TARGET_CONTRACTS=
TARGET_CONTRACT=
START_BLOCK=0
CONFIRMATIONS=12
BATCH_BLOCK_RANGE=2000
# 单次批量请求容纳的块头数。publicnode 允许 100；drpc 免费档只允许 3。
# 换端点补历史时必须与 BATCH_BLOCK_RANGE 一起调整，否则块头阶段会被拒。
RPC_HEADER_BATCH=100
LOG_LEVEL=info

# 查询服务（cmd/api）的监听地址，缺省 :8080。
# 索引器不读这一项。
HTTP_ADDR=:8080

# 每个来源 IP 每分钟的请求上限，缺省 120；设为 0 关闭限流。
HTTP_RATE_LIMIT=120

# 非空时查询服务要求 Authorization: Bearer <API_TOKEN>。
# 留空表示不启用鉴权（本地开发/内网默认）。
# 支持逗号分隔多值（old,new）以便轮换：任一匹配即通过，不必让调用方同时切换。
API_TOKEN=

# 前端构建产物目录，缺省 web/dist。目录不存在时不托管前端。
WEB_DIR=web/dist
